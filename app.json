{
  "expo": {
    "name": "IP Aldeia",
    "slug": "ip-aldeia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "igrejaapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.ipaldeia.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.ipaldeia.app",
      "adaptiveIcon": {
        "backgroundColor": "#A3AC9A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "O app precisa acessar suas fotos para você escolher um avatar."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#A3AC9A",
          "dark": {
            "backgroundColor": "#A3AC9A"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/app-ipaldeia-front"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4cb68c87-fcf2-428b-93b2-9da4850feb2a"
      },
      "googleAuth": {
        "androidClientId": "905093072048-6q1ki35qrjvfm45msopplqbel2ngvlvr.apps.googleusercontent.com",
        "iosClientId": "",
        "webClientId": "905093072048-ia2so5n50abvvpmnouekjhbr8h46s8fb.apps.googleusercontent.com"
      }
    },
    "owner": "aquilesduarte"
  }
}
