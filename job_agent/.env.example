# ============================================================
#  job_agent — exemplo de configuracao. Copie para .env
#  NUNCA comite o arquivo .env real.
# ============================================================

# --- SEGURANCA / MODO DE OPERACAO ---------------------------
# DRY_RUN=true  -> pesquisa, analisa, prepara candidatura, gera CV e respostas,
#                  mas NUNCA envia nada. Este e o padrao.
# DRY_RUN=false -> permite envio, e AINDA ASSIM exige aprovacao manual explicita.
DRY_RUN=true

# Exige confirmacao manual antes de qualquer envio. Mantenha true.
REQUIRE_MANUAL_APPROVAL=true

# --- LLM (OPCIONAL) -----------------------------------------
# O fit score NAO depende de LLM. O LLM apenas redige textos (cover letter,
# mensagens, explicacoes). Sem chave, o sistema usa templates deterministicos.
# Valores: none | anthropic | openai
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=

# --- IDENTIFICACAO NAS REQUISICOES --------------------------
# Enviado no header User-Agent. Use um contato real: e boa pratica e varias
# APIs publicas pedem isso.
CONTACT_EMAIL=seu.email@exemplo.com
USER_AGENT=job-agent/0.1 (+contato: seu.email@exemplo.com)

# --- REDE / RATE LIMITING -----------------------------------
# Segundos minimos entre requisicoes ao MESMO host.
MIN_SECONDS_BETWEEN_REQUESTS=2.0
HTTP_TIMEOUT_SECONDS=30
MAX_REQUESTS_PER_RUN=300
RESPECT_ROBOTS_TXT=true

# --- SERVIDOR / DASHBOARD -----------------------------------
HOST=127.0.0.1
PORT=8765

# --- CAMINHOS (relativos a pasta job_agent/) ----------------
DATABASE_URL=sqlite:///./data/job_agent.db
PROFILE_PATH=./config/profile.yaml
SOURCES_PATH=./config/sources.yaml
RESUME_DIR=./resumes
LOG_DIR=./logs
LOG_LEVEL=INFO
